{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "WebWorker"],
		"types": ["node"],
		"paths": {
			"@/*": ["./src/*"],
			"@test/*": ["./test/*"]
		}
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
