{
	"name": "@bodhiapp/bodhi-pi-coding-agent",
	"version": "0.0.1",
	"private": true,
	"description": "CLI coding agent powered by bodhi-pi, with TUI autocomplete and session management",
	"type": "module",
	"bin": {
		"bodhi-pi": "./dist/cli.js"
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"start": "npm run build && node dist/cli.js"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^0.21.0",
		"@bodhiapp/bodhi-pi": "^0.0.1",
		"@earendil-works/pi-ai": "^0.74.0",
		"@earendil-works/pi-tui": "^0.74.0",
		"better-sqlite3": "^11.10.0",
		"chalk": "^5.4.1",
		"drizzle-orm": "^0.43.1",
		"jiti": "^2.7.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.3.0",
		"shx": "^0.4.0",
		"tsc-alias": "^1.8.10",
		"typescript": "^5.7.3"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
