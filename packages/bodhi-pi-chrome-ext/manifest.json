{
	"manifest_version": 3,
	"name": "bodhi-pi (PoC)",
	"version": "0.0.0",
	"description": "bodhi-pi agent inside a Chrome extension (PoC)",
	"key": "",
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_title": "Open bodhi-pi"
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
		"sandbox": "sandbox allow-scripts allow-forms; script-src 'self' 'unsafe-eval' 'unsafe-inline' 'wasm-unsafe-eval' data:; script-src-elem 'self' 'unsafe-inline' data:; object-src 'self'"
	},
	"sandbox": {
		"pages": ["sandbox.html"]
	}
}
