{
	"name": "@bodhiapp/bodhi-pi",
	"version": "0.0.1",
	"description": "Embeddable, host-mediated, ACP-speaking coding agent.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest --run",
		"test:e2e": "vitest --run --config vitest.e2e.config.ts",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^0.21.0",
		"@mariozechner/pi-agent-core": "^0.73.0",
		"@mariozechner/pi-ai": "^0.73.0",
		"picomatch": "^4.0.4",
		"typebox": "^1.1.24"
	},
	"devDependencies": {
		"@copilotkit/aimock": "^1.19.0",
		"@types/node": "^24.3.0",
		"@types/picomatch": "^4.0.3",
		"dotenv": "^16.4.5",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"keywords": [
		"agent",
		"llm",
		"acp",
		"embeddable",
		"bodhi"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anagri/pi-mono.git",
		"directory": "packages/bodhi-pi"
	}
}
