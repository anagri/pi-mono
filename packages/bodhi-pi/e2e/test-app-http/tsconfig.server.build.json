{
	"extends": "../../../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "../",
		"declaration": true,
		"sourceMap": true,
		"paths": {
			"@/*": ["./src/server/*"],
			"@e2e/*": ["../*"]
		}
	},
	"include": [
		"src/server/**/*.ts",
		"../helpers/node-adapters/**/*.ts",
		"../helpers/extension-loaders/**/*.ts",
		"../helpers/pick-defined.ts",
		"../app-utils/cli/**/*.ts"
	],
	"exclude": ["test", "e2e", "dist", "node_modules", "src/frontend", "**/*.test.ts"]
}
