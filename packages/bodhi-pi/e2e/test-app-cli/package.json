{
	"name": "@bodhiapp/bodhi-pi-test-app-cli",
	"version": "0.0.0",
	"private": true,
	"description": "Test-app CLI for bodhi-pi e2e — copy of bodhi-pi-cli with --rpc and --headless modes added for headless spawn-based testing.",
	"type": "module",
	"main": "./dist/cli.js",
	"bin": {
		"bodhi-pi-test-app-cli": "./dist/cli.js"
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"start": "npm run build && node dist/cli.js"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^0.21.0",
		"@bodhiapp/bodhi-pi": "^0.0.1",
		"@bodhiapp/bodhi-pi-node": "^0.0.1",
		"@earendil-works/pi-ai": "^0.74.0",
		"chalk": "^5.4.1"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"tsc-alias": "^1.8.10",
		"typescript": "^5.7.3"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
