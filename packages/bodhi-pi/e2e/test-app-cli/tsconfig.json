{
	"extends": "../../../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"@/*": ["./src/*"],
			"@e2e/*": ["../*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"../helpers/node-adapters/**/*.ts",
		"../helpers/extension-loaders/**/*.ts",
		"../helpers/pick-defined.ts",
		"../app-utils/cli/**/*.ts"
	]
}
