{
	"extends": "../../../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "../",
		"paths": {
			"@/*": ["./src/*"],
			"@e2e/*": ["../*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"../helpers/node-adapters/**/*.ts",
		"../helpers/extension-loaders/**/*.ts",
		"../helpers/pick-defined.ts",
		"../app-utils/cli/**/*.ts"
	],
	"exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.e2e.ts", "**/*.d.ts"]
}
