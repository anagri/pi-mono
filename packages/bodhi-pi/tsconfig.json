{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"@/*": ["./src/*"],
			"@test/*": ["./test/*"],
			"@e2e/*": ["./e2e/*"]
		}
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "e2e/**/*.ts"],
	"exclude": [
		"e2e/test-app-cli/**",
		"e2e/test-app-http/**",
		"e2e/test-app-browser/**",
		"e2e/helpers/browser-adapters/**"
	]
}
