{
	"name": "@bodhiapp/bodhi-pi-test-app-utils",
	"version": "0.0.0",
	"private": true,
	"description": "Cross-runtime base utilities for bodhi-pi test-apps: just-bash adapters and pickDefined. Standalone — no e2e/ deps.",
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": "./dist/index.js",
		"./pick-defined": "./dist/pick-defined.js",
		"./just-bash-terminal": "./dist/just-bash-terminal.js",
		"./just-bash-fs-adapter": "./dist/just-bash-fs-adapter.js"
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput"
	},
	"dependencies": {
		"@bodhiapp/bodhi-pi": "^0.0.1",
		"just-bash": "^3.0.1"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^5.7.3"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
