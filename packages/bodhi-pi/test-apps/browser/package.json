{
	"name": "@bodhiapp/bodhi-pi-test-app-browser",
	"version": "0.0.0",
	"private": true,
	"description": "Test-app browser for bodhi-pi e2e — Vite+React page hosting the ACP agent in a Web Worker. Also exports a shared browser-side ui-lib/ consumed by test-app-chrome-ext and test-app-http frontend.",
	"type": "module",
	"exports": {
		"./ui": "./src/ui-lib/ui/index.ts",
		"./lib/*": "./src/ui-lib/lib/*.ts",
		"./runtime/*": "./src/ui-lib/runtime/*.ts",
		"./transport/*": "./src/ui-lib/transport/*.ts",
		"./sandbox/*": "./src/ui-lib/sandbox/*.ts",
		"./script-executor/*": "./src/ui-lib/script-executor/*.ts",
		"./sessions/*": "./src/ui-lib/sessions/*.ts",
		"./kv/*": "./src/ui-lib/kv/*.ts",
		"./filesystem/*": "./src/ui-lib/filesystem/*.ts",
		"./extensions/*": "./src/ui-lib/extensions/*.ts"
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "vite",
		"build": "vite build",
		"start": "vite"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^0.21.0",
		"@bodhiapp/bodhi-pi": "^0.0.1",
		"@bodhiapp/bodhi-pi-test-app-utils": "^0.0.0",
		"@earendil-works/pi-ai": "^0.74.0",
		"@zenfs/core": "^2.5.0",
		"@zenfs/dom": "^1.2.0",
		"dexie": "^4.0.11",
		"react": "^19.2.5",
		"react-dom": "^19.2.5"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"just-bash": "^3.0.1",
		"typescript": "^5.7.3",
		"vite": "^8.0.10",
		"vite-plugin-node-polyfills": "^0.26.0"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
