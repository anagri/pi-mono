{
	"name": "@bodhiapp/bodhi-pi-test-app-browser",
	"version": "0.0.0",
	"private": true,
	"description": "Test-app browser for bodhi-pi e2e — Vite+React page hosting the ACP agent in a Web Worker. Also exports a shared browser-side ui-lib/ consumed by test-app-chrome-ext and test-app-http frontend.",
	"type": "module",
	"exports": {
		"./host/runtime/*": "./src/host/runtime/*.ts",
		"./host/extensions/*": "./src/host/extensions/*.ts",
		"./host/filesystem/*": "./src/host/filesystem/*.ts",
		"./host/kv/*": "./src/host/kv/*.ts",
		"./host/sandbox/*": "./src/host/sandbox/*.ts",
		"./host/script-executor/*": "./src/host/script-executor/*.ts",
		"./host/sessions/*": "./src/host/sessions/*.ts",
		"./client": "./src/client/index.ts",
		"./client/react/*": "./src/client/react/*.tsx",
		"./client/runtime/*": "./src/client/runtime/*.ts",
		"./client/lib/*": "./src/client/lib/*.ts"
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "vite",
		"build": "vite build",
		"start": "vite",
		"test": "vitest --run"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^0.21.0",
		"@bodhiapp/bodhi-pi": "^0.0.1",
		"@bodhiapp/bodhi-pi-test-app-utils": "^0.0.0",
		"@earendil-works/pi-ai": "^0.74.0",
		"@zenfs/core": "^2.5.0",
		"@zenfs/dom": "^1.2.0",
		"dexie": "^4.0.11",
		"react": "^19.2.5",
		"react-dom": "^19.2.5"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"fake-indexeddb": "^6.0.0",
		"just-bash": "^3.0.1",
		"typescript": "^5.7.3",
		"vite": "^8.0.10",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
