{
	"name": "@bodhiapp/bodhi-pi-e2e-ui",
	"version": "0.0.0",
	"private": true,
	"description": "Playwright UI test suite for bodhi-pi — one set of specs running across the test-app-* hosts (http, ws, browser, chrome-ext).",
	"type": "module",
	"scripts": {
		"test": "playwright test",
		"test:http": "playwright test --project=http",
		"test:ws": "playwright test --project=ws",
		"test:browser": "playwright test --project=browser",
		"test:chrome-ext": "playwright test --project=chrome-ext"
	},
	"devDependencies": {
		"@bodhiapp/bodhi-pi": "^0.0.1",
		"@playwright/test": "^1.49.0",
		"@types/node": "^24.3.0",
		"dotenv": "^16.4.5",
		"typescript": "^5.7.3"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
