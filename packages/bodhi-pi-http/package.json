{
	"name": "@bodhiapp/bodhi-pi-http",
	"version": "0.0.1",
	"private": true,
	"description": "HTTP+SSE-hosted (MCP-Streamable-HTTP-shaped) reference host for bodhi-pi",
	"type": "module",
	"main": "./dist/server/index.js",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "npm run build:server && npm run build:frontend",
		"build:server": "tsgo -p tsconfig.server.build.json",
		"build:frontend": "vite build",
		"dev": "concurrently --names \"server,frontend\" --prefix-colors \"yellow,cyan\" \"npm run dev:server\" \"npm run dev:frontend\"",
		"dev:server": "tsx watch src/server/index.ts",
		"dev:frontend": "vite",
		"start": "node dist/server/index.js",
		"test": "vitest --run --config vitest.config.ts",
		"test:e2e": "vitest --run --config vitest.e2e.config.ts",
		"test:playwright": "playwright test"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^0.21.0",
		"@bodhiapp/bodhi-pi": "^0.0.1",
		"@bodhiapp/bodhi-pi-node": "^0.0.1",
		"@earendil-works/pi-ai": "^0.74.0",
		"better-sqlite3": "^11.10.0",
		"drizzle-orm": "^0.43.1",
		"react": "^19.2.5",
		"react-dom": "^19.2.5"
	},
	"devDependencies": {
		"@playwright/test": "^1.50.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.3.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"concurrently": "^9.2.1",
		"tsx": "^4.20.3",
		"typescript": "^5.7.3",
		"vite": "^8.0.10",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
