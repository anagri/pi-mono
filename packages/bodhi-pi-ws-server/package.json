{
	"name": "@bodhiapp/bodhi-pi-ws-server",
	"version": "0.0.1",
	"private": true,
	"description": "WebSocket-hosted multi-user agent backend for bodhi-pi",
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
