		"start": "node dist/index.js",
		"test": "vitest --run"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^0.21.0",
		"@bodhiapp/bodhi-pi": "^0.0.1",
		"@bodhiapp/bodhi-pi-node": "^0.0.1",
		"@earendil-works/pi-ai": "^0.74.0",
