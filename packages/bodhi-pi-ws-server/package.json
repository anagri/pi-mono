		"drizzle-orm": "^0.43.1",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.3.0",
		"@types/ws": "^8.5.13",
		"tsx": "^4.20.3",
		"typescript": "^5.7.3",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^3.2.4"
